# Google Gemini API Key (требуется для Gemini Live и Gemini Flash)
# Получить: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (требуется для ResearchAgent - веб-поиск)
# Получить: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Параметры подключения к PostgreSQL (с pgvector)
# Значения по умолчанию соответствуют src/docker-compose.yml
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jarvis_memory
